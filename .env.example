# App
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=clauseiq
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Storage (use MinIO locally, AWS S3 in prod)
STORAGE_BUCKET=clauseiq-contracts
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:9000  # MinIO local endpoint

# ML Model
MODEL_NAME=nlpaueb/legal-bert-base-uncased
MODEL_PATH=ml/models/weights/clause_classifier
MAX_SEQUENCE_LENGTH=512

# W&B (optional, for training tracking)
WANDB_API_KEY=
WANDB_PROJECT=clauseiq

# Contract review app (LLM extraction engine)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=high
LLM_MAX_CHARS_PER_CALL=400000
LLM_CHUNK_OVERLAP_CHARS=4000
REVIEW_DB_URL=sqlite:///clauseiq_review.db
